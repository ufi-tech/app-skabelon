# Kopiér til .env og ret. Filen .env er i .gitignore og må aldrig committes.
#
# APP_UID og APP_GID skal være den bruger, der ejer repoet, så api-containeren kan
# skrive i data/. Find dem med `id -u` og `id -g`.
APP_UID=1000
APP_GID=1000

# Proxyen i workspacets VM. En container kan ikke nå VM'ens loopback, så adressen er
# docker-broens gateway og ikke 127.0.0.1.
HTTP_PROXY=http://172.20.0.1:3128
HTTPS_PROXY=http://172.20.0.1:3128
NO_PROXY=127.0.0.1,localhost,api,web,172.20.0.0/16,10.77.0.0/24

# Sessionshemmeligheden. Lad den stå tom, så laver appen selv en og gemmer den i
# datamappen med rettighederne 600. Sættes den, skal den være mindst 32 tegn.
SESSION_HEMMELIGHED=

# Brugeren der oprettes med `python brugere.py <e-post> "<navn>"`. Sæt den i skallen,
# kør kommandoen, og fjern den igen.
START_ADGANGSKODE=
